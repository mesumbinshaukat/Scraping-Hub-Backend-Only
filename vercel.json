{
    "version": 2,
    "functions": {
        "api/*.js": {
            "maxDuration": 10,
            "memory": 1024
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/app.js"
        }
    ],
    "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0",
        "VERCEL": "1",
        "PROXY_ENABLED": "true",
        "MAX_RETRIES": "3",
        "SCRAPE_DELAY": "2000"
    },
    "crons": [
        {
            "path": "/health",
            "schedule": "0 0 * * *"
        }
    ]
}