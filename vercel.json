{
    "version": 2,
    "builds": [
        {
            "src": "src/app.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60,
                "memory": 3008
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/app.js"
        }
    ],
    "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
    },
    "crons": [
        {
            "path": "/health",
            "schedule": "0 0 * * *"
        }
    ]
}