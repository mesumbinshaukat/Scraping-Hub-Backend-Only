{
    "version": 2,
    "functions": {
        "api/index.js": {
            "maxDuration": 10,
            "memory": 1024
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.js"
        }
    ],
    "env": {
        "VERCEL": "1",
        "PROXY_ENABLED": "true",
        "MAX_RETRIES": "3",
        "SCRAPE_DELAY": "2000",
        "IGNORE_SSL_ERRORS": "false"
    },
    "crons": [
        {
            "path": "/api/cron/cleanup",
            "schedule": "0 0 * * *"
        }
    ]
}